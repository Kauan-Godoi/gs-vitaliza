---
import { Image } from 'astro:assets';

// Comparador antes/depois. Aceita duas fotos separadas (before + after), uma única
// foto "empilhada" com o antes em cima e o depois embaixo (stacked), ou nenhuma
// foto — nesse caso mostra um espaço reservado com o mesmo formato.
interface Props {
  alt: string;
  before?: ImageMetadata;
  after?: ImageMetadata;
  stacked?: ImageMetadata;
  ratio?: string;
}

const { before, after, stacked, alt, ratio = '4 / 3' } = Astro.props;
const beforeSrc = stacked ?? before;
const afterSrc = stacked ?? after;
const isPlaceholder = !beforeSrc || !afterSrc;
---

<div class:list={['ba', { 'ba--placeholder': isPlaceholder }]} style={`aspect-ratio: ${ratio}`} data-ba>
  {isPlaceholder ? (
    <div class="ba__slot ba__slot--after"><span>Foto do depois<br /><small>em breve</small></span></div>
  ) : (
    <Image
      class="ba__img"
      src={afterSrc}
      alt={`Depois: ${alt}`}
      widths={[480, 720, 960]}
      sizes="(max-width: 900px) 92vw, 560px"
      style={stacked ? 'object-position: center bottom' : undefined}
    />
  )}
  <div class="ba__before">
    {isPlaceholder ? (
      <div class="ba__slot ba__slot--before"><span>Foto do antes<br /><small>em breve</small></span></div>
    ) : (
      <Image
        class="ba__img"
        src={beforeSrc}
        alt={`Antes: ${alt}`}
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 92vw, 560px"
        style={stacked ? 'object-position: center top' : undefined}
      />
    )}
  </div>
  <span class="ba__tag ba__tag--before">Antes</span>
  <span class="ba__tag ba__tag--after">Depois</span>
  <span class="ba__handle" aria-hidden="true"></span>
  <input class="ba__range" type="range" min="0" max="100" value="50" aria-label={`Arraste para comparar antes e depois: ${alt}`} />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.ba__range')!;
    const update = () => el.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', update);
    update();
  });
</script>

<style>
  .ba {
    --pos: 50%;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    user-select: none;
    background: var(--line);
  }

  .ba :global(.ba__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ba__before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  /* Espaço reservado enquanto não há foto */
  .ba__slot {
    position: absolute;
    inset: 0;
    display: grid;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.3;
    text-align: center;
  }

  .ba__slot small {
    font-weight: 500;
  }

  .ba__slot--before {
    place-items: center start;
    padding-left: 12%;
    background: repeating-linear-gradient(135deg, #e7ebf2 0 14px, #eef1f6 14px 28px);
  }

  .ba__slot--after {
    place-items: center end;
    padding-right: 12%;
    background: repeating-linear-gradient(135deg, #dfe9fb 0 14px, #e9f0fc 14px 28px);
    color: var(--blue-700);
  }

  .ba--placeholder {
    outline: 2px dashed #c3d3ee;
    outline-offset: -2px;
  }

  .ba__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    pointer-events: none;
  }

  .ba__handle::after {
    content: '⟷';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    color: var(--blue-700);
    font-size: 1.2rem;
    font-weight: 700;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.25);
  }

  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .ba:has(.ba__range:focus-visible) .ba__handle::after {
    outline: 3px solid var(--blue-500);
  }

  .ba__tag {
    position: absolute;
    top: 12px;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(15 27 45 / 0.7);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    pointer-events: none;
  }

  .ba__tag--before {
    left: 12px;
  }

  .ba__tag--after {
    right: 12px;
    background: var(--blue-600);
  }
</style>
