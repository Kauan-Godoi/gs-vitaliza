---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../utils/date';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<article class="post-card">
  <a href={`/blog/${post.id}/`}>
    <div class="post-card__media">
      <Image src={post.data.cover} alt={post.data.coverAlt} widths={[360, 540, 720]} sizes="(max-width: 640px) 92vw, 360px" />
    </div>
    <div class="post-card__body">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h3>{post.data.title}</h3>
      <p>{post.data.description}</p>
      <span class="post-card__more">Ler artigo →</span>
    </div>
  </a>
</article>

<style>
  .post-card a {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .post-card a:hover {
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .post-card__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .post-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px;
  }

  .post-card time {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .post-card h3 {
    font-size: 1.2rem;
  }

  .post-card p {
    color: var(--muted);
    font-size: 0.95rem;
    flex: 1;
  }

  .post-card__more {
    color: var(--blue-600);
    font-weight: 700;
  }
</style>
