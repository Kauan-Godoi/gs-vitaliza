---
import { Image, getImage } from 'astro:assets';
import BeforeAfter from '../BeforeAfter.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { beforeAfter } from '../../data/results';

// Para adicionar fotos: coloque o arquivo em src/assets/portfolio e inclua aqui.
const gallery = [
  { file: '01.jpg', caption: 'Sofá retrátil em L' },
  { file: '10.jpg', caption: 'Sofá orgânico em suede' },
  { file: '11.jpg', caption: 'Interior automotivo em couro' },
  { file: '06.jpg', caption: 'Sofá com chaise' },
  { file: '05.jpg', caption: 'Poltronas de salão de beleza' },
  { file: '03.jpg', caption: 'Sofá-cama' },
  { file: '04.jpg', caption: 'Bancos automotivos em tecido' },
  { file: '09.jpg', caption: 'Cadeiras de jantar' },
];

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/portfolio/*.jpg', { eager: true });
const items = await Promise.all(
  gallery.map(async (g) => {
    const img = images[`../../assets/portfolio/${g.file}`].default;
    const large = await getImage({ src: img, width: 1200 });
    return { ...g, img, large: large.src };
  }),
);

const resultPhotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/resultados/*.{jpg,jpeg,png,webp}', { eager: true });
const photo = (file?: string) => (file ? resultPhotos[`../../assets/resultados/${file}`]?.default : undefined);
const pairs = beforeAfter.map((p) => ({ ...p, before: photo(p.before), after: photo(p.after), stacked: photo(p.stacked) }));
---

<section class="section" id="resultados">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Resultados reais</span>
      <h2 class="section-title">Veja a diferença</h2>
      <p class="section-lead">Fotos de atendimentos feitos pela nossa equipe. Arraste para comparar o antes e depois.</p>
    </div>

    <div class="pairs">
      {pairs.map((p) => (
        <figure class="pair reveal">
          <BeforeAfter before={p.before} after={p.after} stacked={p.stacked} alt={p.title.toLowerCase()} ratio="3 / 4" />
          <figcaption>
            <strong>{p.title}</strong>
            <span>{p.description}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="gallery__head reveal">
      <h3>Mais trabalhos realizados</h3>
      <a class="btn btn--outline" href={site.instagram} target="_blank" rel="noopener">
        <Icon name="instagram" /> Ver no Instagram
      </a>
    </div>

    <ul class="gallery">
      {items.map((it, i) => (
        <li class="reveal">
          <button class="gallery__item" type="button" data-full={it.large} data-caption={it.caption} data-index={i}>
            <Image src={it.img} alt={it.caption} widths={[280, 420, 560]} sizes="(max-width: 640px) 46vw, 280px" />
            <span class="gallery__caption">{it.caption}</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Foto ampliada">
    <button class="lightbox__close" type="button" data-close aria-label="Fechar"><Icon name="close" /></button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-prev aria-label="Foto anterior"><Icon name="arrow-left" /></button>
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" type="button" data-next aria-label="Próxima foto"><Icon name="arrow-right" /></button>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const img = dialog.querySelector('img')!;
  const caption = dialog.querySelector('figcaption')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.gallery__item')];
  let current = 0;

  const show = (i: number) => {
    current = (i + buttons.length) % buttons.length;
    const b = buttons[current];
    img.src = b.dataset.full!;
    img.alt = b.dataset.caption!;
    caption.textContent = b.dataset.caption!;
  };

  buttons.forEach((b, i) =>
    b.addEventListener('click', () => {
      show(i);
      dialog.showModal();
    }),
  );
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
  dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
  dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  /* Flex em vez de grid para centralizar a última linha quando ela não fecha. */
  .pairs {
    --cols: 3;
    --gap: 24px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    margin-bottom: clamp(48px, 6vw, 72px);
  }

  .pair {
    flex: 0 1 calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    margin: 0;
  }

  .pair figcaption {
    display: grid;
    gap: 2px;
    padding: 14px 4px 0;
  }

  .pair figcaption strong {
    font-size: 1.1rem;
  }

  .pair figcaption span {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .gallery__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .gallery__head h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--line);
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .gallery__item:hover :global(img) {
    transform: scale(1.05);
  }

  .gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 28px 12px 10px;
    background: linear-gradient(transparent, rgb(10 20 40 / 0.75));
    color: #fff;
    font-weight: 600;
    font-size: 0.875rem;
    text-align: left;
  }

  .lightbox {
    width: min(92vw, 720px);
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #0b1424;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(5 10 20 / 0.85);
  }

  .lightbox figure {
    margin: 0;
  }

  .lightbox :global(img) {
    width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .lightbox figcaption {
    padding: 12px 16px;
    color: #fff;
    font-weight: 600;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    z-index: 1;
    box-shadow: var(--shadow-sm);
  }

  .lightbox__close {
    top: -16px;
    right: -16px;
  }

  .lightbox__nav {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__nav--prev {
    left: -22px;
  }

  .lightbox__nav--next {
    right: -22px;
  }

  @media (max-width: 1100px) {
    .pairs {
      --cols: 2;
    }
  }

  @media (max-width: 560px) {
    .pairs {
      --cols: 1;
    }
  }

  @media (max-width: 900px) {

    .gallery {
      grid-template-columns: repeat(2, 1fr);
    }

    .lightbox__close {
      top: 8px;
      right: 8px;
    }

    .lightbox__nav--prev {
      left: 8px;
    }

    .lightbox__nav--next {
      right: 8px;
    }
  }
</style>
