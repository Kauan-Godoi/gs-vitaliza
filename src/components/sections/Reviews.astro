---
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { timeAgo } from '../../utils/relative-time';
import data from '../../data/reviews.json';

type Review = { author: string; photo: string | null; rating: number; text: string; date: string };
const reviews = data.reviews as Review[];

const rating = site.google.rating.toFixed(1).replace('.', ',');
const initial = (name: string) => name.trim().charAt(0).toUpperCase();
---

<section class="section section--soft" id="avaliacoes">
  <div class="container">
    <div class="section-head reveal">
      <h2 class="section-title">O que dizem nossos clientes</h2>
      <p class="section-lead">Avaliações reais deixadas por clientes no Google, sem seleção nem edição de conteúdo.</p>
    </div>

    <div class="badge reveal">
      <a class="badge__score" href={site.google.profileUrl} target="_blank" rel="noopener" aria-label={`Nota ${rating} de 5 no Google, ${site.google.reviewCount} avaliações`}>
        <svg class="badge__g" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
          <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
        </svg>
        <strong>{rating}</strong>
        <span class="stars stars--blue">{Array.from({ length: 5 }).map(() => <Icon name="star" />)}</span>
        <span class="badge__count">{site.google.reviewCount} avaliações</span>
      </a>
      <a class="badge__write" href={site.google.reviewUrl} target="_blank" rel="noopener">Escrever avaliação</a>
    </div>

    {reviews.length > 0 ? (
      <div class="carousel reveal" data-carousel>
        <ul class="carousel__track" data-track>
          {reviews.map((r) => (
            <li class="review">
              <header class="review__head">
                {r.photo ? (
                  <img class="review__avatar" src={r.photo} alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer" />
                ) : (
                  <span class="review__avatar" aria-hidden="true">{initial(r.author)}</span>
                )}
                <div>
                  <strong class="review__name">{r.author}</strong>
                  <div class="review__meta">
                    <span class="stars stars--blue" aria-label={`${r.rating} de 5 estrelas`}>
                      {Array.from({ length: r.rating }).map(() => <Icon name="star" />)}
                    </span>
                    <time datetime={r.date} data-time-ago>{timeAgo(r.date)}</time>
                  </div>
                </div>
              </header>
              <p class="review__text" data-text>{r.text}</p>
              <button class="review__more" type="button" data-more hidden>Leia mais</button>
            </li>
          ))}
        </ul>
        <div class="carousel__controls">
          <button type="button" data-prev aria-label="Avaliações anteriores"><Icon name="arrow-left" size={16} /></button>
          <button type="button" data-next aria-label="Próximas avaliações"><Icon name="arrow-right" size={16} /></button>
        </div>
      </div>
    ) : (
      <p class="reviews__empty reveal">
        <a class="btn btn--primary" href={site.google.profileUrl} target="_blank" rel="noopener">
          Ler as {site.google.reviewCount} avaliações no Google
        </a>
      </p>
    )}
  </div>
</section>

<script>
  import { timeAgo } from '../../utils/relative-time';

  // O site é estático: recalcula "x meses atrás" com a data de hoje.
  document.querySelectorAll<HTMLTimeElement>('[data-time-ago]').forEach((t) => {
    t.textContent = timeAgo(t.dateTime);
  });

  // "Leia mais" só aparece quando o texto foi cortado.
  document.querySelectorAll<HTMLElement>('.review').forEach((card) => {
    const text = card.querySelector<HTMLElement>('[data-text]')!;
    const more = card.querySelector<HTMLButtonElement>('[data-more]')!;
    if (text.scrollHeight > text.clientHeight + 2) more.hidden = false;
    more.addEventListener('click', () => {
      const open = card.classList.toggle('is-open');
      more.textContent = open ? 'Mostrar menos' : 'Leia mais';
    });
  });

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-track]')!;
    const step = () => (track.firstElementChild as HTMLElement).offsetWidth + 16;
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
    const atStart = () => track.scrollLeft <= 4;

    const next = () => track.scrollBy({ left: atEnd() ? -track.scrollWidth : step(), behavior: 'smooth' });
    const prev = () => track.scrollBy({ left: atStart() ? track.scrollWidth : -step(), behavior: 'smooth' });
    carousel.querySelector('[data-next]')!.addEventListener('click', next);
    carousel.querySelector('[data-prev]')!.addEventListener('click', prev);

    // Avança sozinho; pausa enquanto o visitante interage.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let timer = 0;
    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(next, 5000);
    };
    const stop = () => window.clearInterval(timer);
    start();
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    track.addEventListener('touchstart', stop, { passive: true });
  });
</script>

<style>
  .section-head {
    margin-bottom: 28px;
  }

  .stars--blue {
    color: var(--blue-600);
  }

  /* Selo do Google */
  .badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 40px;
    padding: 10px 12px 10px 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
  }

  .badge__score {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }

  .badge__g {
    width: 26px;
    height: 26px;
  }

  .badge__score strong {
    font-size: 1.15rem;
  }

  .badge__score :global(.stars svg) {
    width: 16px;
    height: 16px;
  }

  .badge__count {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .badge__write {
    padding: 7px 14px;
    border: 1px solid var(--line);
    border-radius: 8px;
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .badge__write:hover {
    border-color: var(--blue-600);
    color: var(--blue-600);
  }

  /* Carrossel */
  .carousel {
    position: relative;
  }

  .carousel__track {
    list-style: none;
    margin: 0;
    padding: 4px 6% 12px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 300px;
    gap: 16px;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 6%;
    scrollbar-width: none;
    /* Laterais esmaecidas, como no widget de referência */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .review {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 210px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .review__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--blue-900);
    color: #fff;
    font-weight: 700;
  }

  .review__name {
    display: block;
    font-size: 0.95rem;
    line-height: 1.3;
  }

  .review__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 8px;
  }

  .review__meta :global(.stars svg) {
    width: 14px;
    height: 14px;
  }

  .review__meta time {
    white-space: nowrap;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .review__text {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .review.is-open .review__text {
    -webkit-line-clamp: unset;
    overflow: visible;
  }

  .review__more {
    align-self: flex-start;
    padding: 0;
    border: 0;
    background: none;
    color: var(--blue-600);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }

  .carousel__controls {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
  }

  .carousel__controls button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }

  .carousel__controls button:hover {
    border-color: var(--blue-600);
    color: var(--blue-600);
  }

  .reviews__empty {
    text-align: center;
    margin: 0;
  }

  @media (max-width: 640px) {
    .carousel__track {
      grid-auto-columns: 82%;
      padding-inline: 9%;
      scroll-padding-inline: 9%;
    }

    .badge {
      justify-content: center;
    }
  }
</style>
