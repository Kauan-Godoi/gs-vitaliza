---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { site, whatsappLink } from '../../data/site';
import fallbackPhoto from '../../assets/portfolio/09.jpg';

// Foto opcional para esta seção (ex.: o Cal em atendimento): salve como src/assets/brand/sobre.jpg.
const owner = Object.values(
  import.meta.glob<{ default: ImageMetadata }>('../../assets/brand/sobre.{jpg,jpeg,png,webp}', { eager: true }),
)[0]?.default;
const photo = owner ?? fallbackPhoto;
const photoAlt = owner ? `${site.owner.name} durante um atendimento da GS Vitaliza` : 'Equipamento da GS Vitaliza em atendimento a domicílio';

const stats = [
  { value: site.google.rating.toFixed(1).replace('.', ','), label: 'nota média no Google' },
  { value: `${site.google.reviewCount}`, label: 'avaliações de clientes' },
  { value: '7 dias', label: 'de atendimento' },
];
---

<section class="section" id="sobre">
  <div class="container about">
    <div class="about__media reveal">
      <Image src={photo} alt={photoAlt} widths={[400, 600, 800]} sizes="(max-width: 900px) 92vw, 460px" />
      <div class="about__badge">
        <Icon name="award" size={28} />
        <span>Higienização profissional<br />em {site.city}</span>
      </div>
    </div>

    <div class="about__content reveal">
      <span class="eyebrow">Sobre nós</span>
      <h2 class="section-title">Cuidar da sua casa é cuidar de quem mora nela</h2>

      {/* TODO: trocar pelo texto com a história do Cal (como começou, por que escolheu a área, o que o motiva).
          Texto provisório e genérico de propósito: não citar anos de experiência, cursos nem números sem confirmação. */}
      <p>
        Por trás da GS Vitaliza está o <strong>{site.owner.name}</strong>, que leva até a sua casa a higienização de sofás,
        colchões, tapetes e bancos de carro, com equipamento profissional e produtos certificados.
      </p>
      <p>
        O atendimento é direto com ele, do orçamento pelo WhatsApp até o serviço no seu espaço: cada peça é avaliada antes
        de começar, e você sabe com clareza o que dá para resolver. As avaliações dos clientes no Google mostram o resultado
        desse cuidado.
      </p>

      <dl class="about__stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>

      <a class="btn btn--whatsapp" href={whatsappLink()} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Fale com a gente
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 460px) 1fr;
    gap: clamp(40px, 6vw, 80px);
    align-items: center;
  }

  .about__media {
    position: relative;
  }

  .about__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: var(--shadow);
  }

  .about__badge {
    position: absolute;
    right: -20px;
    bottom: 32px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    background: var(--blue-600);
    color: #fff;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .about__content p {
    color: var(--muted);
    font-size: 1.05rem;
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 32px 0;
  }

  .about__stats div {
    display: flex;
    flex-direction: column-reverse;
    padding: 18px;
    border-radius: var(--radius-sm);
    background: var(--blue-50);
  }

  .about__stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--blue-700);
    line-height: 1.1;
  }

  .about__stats dt {
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__media {
      max-width: 460px;
    }

    .about__badge {
      right: 12px;
    }
  }

  @media (max-width: 480px) {
    .about__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
