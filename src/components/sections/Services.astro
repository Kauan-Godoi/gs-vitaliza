---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { services, whatsappLink } from '../../data/site';
import sofa from '../../assets/portfolio/01.jpg';
import mattress from '../../assets/portfolio/02.jpg';
import car from '../../assets/portfolio/04.jpg';
import chairs from '../../assets/portfolio/09.jpg';
import rug from '../../assets/portfolio/12.jpg';
import plush from '../../assets/portfolio/08.jpg';

const media: Record<string, { src: ImageMetadata; alt: string; position?: string }> = {
  sofas: { src: sofa, alt: 'Sofá retrátil em L durante a higienização' },
  colchoes: { src: mattress, alt: 'Colchão king higienizado' },
  automotivos: { src: car, alt: 'Bancos de carro em tecido higienizados' },
  'poltronas-cadeiras': { src: chairs, alt: 'Cadeiras de jantar estofadas higienizadas' },
  // A foto do tapete é um antes/depois vertical; mostramos só a metade "depois".
  tapetes: { src: rug, alt: 'Tapete com cores recuperadas após a higienização', position: 'center 85%' },
  infantil: { src: plush, alt: 'Pelúcias higienizadas' },
};
---

<section class="section" id="servicos">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Nossos serviços</span>
      <h2 class="section-title">O que higienizamos</h2>
      <p class="section-lead">
        Limpeza profunda por extração, com produtos profissionais, para residências, carros e empresas.
      </p>
    </div>

    <div class="services">
      {services.map((s) => {
        const m = media[s.id];
        return (
          <article class="service reveal">
            <div class="service__media">
              <Image
                src={m.src}
                alt={m.alt}
                widths={[360, 540, 720]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 360px"
                style={m.position ? `object-position: ${m.position}` : undefined}
              />
              <span class="service__icon"><Icon name={s.icon} /></span>
            </div>
            <div class="service__body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <a
                class="service__link"
                href={whatsappLink(`Olá! Vim pelo site e gostaria de um orçamento de higienização de ${s.title.toLowerCase()}.`)}
                target="_blank"
                rel="noopener"
              >
                Pedir orçamento <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .service {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .service:hover {
    box-shadow: var(--shadow);
    transform: translateY(-4px);
  }

  .service__media {
    position: relative;
    aspect-ratio: 16 / 11;
  }

  .service__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .service__icon {
    position: absolute;
    left: 20px;
    bottom: -24px;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--blue-600);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  .service__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 40px 24px 24px;
  }

  .service__body h3 {
    font-size: 1.3rem;
  }

  .service__body p {
    color: var(--muted);
    flex: 1;
  }

  .service__link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
    text-decoration: none;
  }

  .service__link:hover {
    gap: 8px;
  }

  @media (max-width: 1024px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
